{
  "name": "poultry-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Simple Poultry Management System",
  "scripts": {
    "start": "node src/backend/server.js",
    "dev": "node src/backend/server.js",
    "build": "prisma generate --schema=src/backend/prisma/schema.prisma && prisma migrate deploy --schema=src/backend/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=src/backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=src/backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.20.0"
  }
}